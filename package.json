{
  "name": "pact-of-the-fallen",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "망자의 계약 (Pact of the Fallen) — 2D 횡스크롤 핵앤슬래시 로그라이트 + 수집형 가챠",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "build:pages": "tsc --noEmit && vite build --base ./ --outDir docs --emptyOutDir && node -e \"require('fs').writeFileSync('docs/.nojekyll', '')\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "node scripts/e2e.mjs"
  },
  "devDependencies": {
    "playwright": "1.56.1",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
